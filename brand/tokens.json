{
  "$schema": "storystick-brand-tokens/1.0",
  "brand": {
    "name": "Storystick",
    "tagline": "Draw it before you build it.",
    "version": "1.0",
    "issued": "2026-08"
  },
  "color": {
    "blueprint": {
      "value": "#0F2338",
      "use": "Primary dark. Canvas chrome, headers, reverse fields."
    },
    "ink": {
      "value": "#0A1826",
      "use": "Deepest neutral. Rare \u2014 modal scrims, print black."
    },
    "canvas": {
      "value": "#0B1A2B",
      "use": "The drawing surface in Blueprint mode."
    },
    "panel": {
      "value": "#132B44",
      "use": "Side panels, toolbar body."
    },
    "panel-line": {
      "value": "#23405E",
      "use": "Borders on dark surfaces."
    },
    "blue": {
      "value": "#1B5FA6",
      "use": "Primary brand. Mark, primary buttons, links, active tools."
    },
    "sky": {
      "value": "#3E86CE",
      "use": "Hover/focus on blue. Dimension lines on dark canvas."
    },
    "chalk": {
      "value": "#A9C7E5",
      "use": "Geometry and grid on dark, secondary text on dark."
    },
    "cedar": {
      "value": "#D98235",
      "use": "Accent. Transfer line, selection, one CTA per screen."
    },
    "ember": {
      "value": "#EFA860",
      "use": "Cedar for dark surfaces. 7.92:1 on Blueprint."
    },
    "cedar-deep": {
      "value": "#9E5813",
      "use": "Cedar that can carry text on light. 4.95:1 on Vellum."
    },
    "vellum": {
      "value": "#F7F4ED",
      "use": "Default light background. Paper-mode canvas."
    },
    "paper": {
      "value": "#FFFFFF",
      "use": "Cards, inputs, elevated surfaces."
    },
    "graphite": {
      "value": "#46525E",
      "use": "Body copy on light. 7.27:1 on Vellum."
    },
    "slate": {
      "value": "#65717C",
      "use": "Secondary text, labels, captions. 4.54:1 on Vellum."
    },
    "slate-40": {
      "value": "#8A97A3",
      "use": "Disabled, placeholder, decorative only."
    },
    "mist": {
      "value": "#E4E9EE",
      "use": "Borders, dividers, rules, inactive fills."
    },
    "green": {
      "value": "#1F9D6B",
      "use": "Snapped, square, in tolerance. Shapes and icons."
    },
    "green-deep": {
      "value": "#177C54",
      "use": "Text-safe green. 4.72:1 on Vellum."
    },
    "red": {
      "value": "#D14343",
      "use": "Out of tolerance, conflict."
    },
    "red-deep": {
      "value": "#B93636",
      "use": "Text-safe red, destructive buttons. 5.25:1 on Vellum."
    }
  },
  "font": {
    "brand": {
      "family": "Space Grotesk",
      "weights": [
        400,
        500,
        700
      ],
      "use": "Wordmark, headings, display",
      "license": "SIL OFL 1.1"
    },
    "sans": {
      "family": "Inter",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "use": "Interface and body copy",
      "license": "SIL OFL 1.1"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "use": "Dimensions, coordinates, cut lists, part numbers",
      "license": "SIL OFL 1.1"
    }
  },
  "type-scale": {
    "display": {
      "size": 64,
      "line": 66,
      "tracking": "-0.03em",
      "font": "brand",
      "weight": 500
    },
    "h1": {
      "size": 44,
      "line": 48,
      "tracking": "-0.025em",
      "font": "brand",
      "weight": 500
    },
    "h2": {
      "size": 32,
      "line": 38,
      "tracking": "-0.015em",
      "font": "brand",
      "weight": 500
    },
    "h3": {
      "size": 21,
      "line": 28,
      "tracking": "-0.01em",
      "font": "brand",
      "weight": 500
    },
    "body-lg": {
      "size": 18,
      "line": 30,
      "tracking": "0",
      "font": "sans",
      "weight": 400
    },
    "body": {
      "size": 16,
      "line": 26,
      "tracking": "0",
      "font": "sans",
      "weight": 400
    },
    "small": {
      "size": 14,
      "line": 21,
      "tracking": "0",
      "font": "sans",
      "weight": 400
    },
    "label": {
      "size": 12,
      "line": 16,
      "tracking": "0.08em",
      "font": "sans",
      "weight": 600,
      "transform": "uppercase"
    },
    "dimension": {
      "size": 13,
      "line": 18,
      "tracking": "0.01em",
      "font": "mono",
      "weight": 500
    },
    "data": {
      "size": 12,
      "line": 20,
      "tracking": "0.01em",
      "font": "mono",
      "weight": 400
    }
  },
  "space": {
    "base": 8,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ]
  },
  "radius": {
    "sm": 6,
    "md": 9,
    "lg": 14,
    "xl": 20,
    "icon": "22.37% of tile"
  },
  "elevation": {
    "1": "0 1px 2px rgba(15,35,56,.07)",
    "2": "0 3px 10px rgba(15,35,56,.10)",
    "3": "0 12px 34px rgba(15,35,56,.16)"
  },
  "canvas-spec": {
    "background": "#0B1A2B",
    "grid-minor": "chalk @ 6% \u00b7 1px",
    "grid-major": "chalk @ 12% \u00b7 1px \u00b7 every 5",
    "geometry": "chalk \u00b7 1.5px",
    "selected": "cedar \u00b7 2px",
    "dimension-line": "sky \u00b7 1px \u00b7 3-2 dash",
    "dimension-text": "IBM Plex Mono 11 \u00b7 chalk",
    "snap": "green \u00b7 6px square",
    "error": "red \u00b7 2px + icon"
  },
  "line-weights-mm": {
    "section-cut": 0.7,
    "outline": 0.5,
    "surface": 0.35,
    "dimension": 0.25,
    "construction": 0.18
  }
}